{
  "format": "openshortcuts-adapter",
  "version": 2,
  "id": "github",
  "name": "GitHub",
  "subtitle": "Pull requests, reviews and issues",
  "glyph": "braces",
  "tint": "Gray",
  "baseUrl": "https://api.github.com",
  "allowedDomains": [],
  "authKind": "bearer",
  "authHeader": "Authorization",
  "authPrefix": "Bearer ",
  "tokenHint": "A fine-grained personal access token",
  "tabs": [
    {
      "id": "overview",
      "label": "Overview",
      "endpoint": "/user",
      "widgets": [
        {
          "id": "me",
          "type": "profile_card",
          "title": "Profile",
          "tint": "Gray",
          "endpoint": "/user",
          "titlePath": "name",
          "subtitlePath": "login",
          "metaPath": "html_url",
          "badgePath": "type"
        },
        {
          "id": "stats",
          "type": "stat_grid",
          "title": "Account",
          "endpoint": "/user",
          "metrics": [
            {
              "label": "Public repos",
              "valuePath": "public_repos",
              "tint": "Blue"
            },
            {
              "label": "Followers",
              "valuePath": "followers",
              "tint": "Indigo"
            }
          ]
        },
        {
          "id": "ship",
          "type": "share_card",
          "title": "Stracode",
          "tint": "Green",
          "glyph": "laptopRun",
          "endpoint": "/user",
          "titlePath": "login",
          "itemsEndpoint": "/search/commits?q=author:{{login}}+author-date:%3E%3D{{since_120d}}&sort=author-date&order=desc&per_page=100",
          "itemsPath": "items",
          "metaPath": "commit.author.date",
          "messagePath": "commit.message",
          "groupPath": "repository.full_name"
        }
      ]
    },
    {
      "id": "prs",
      "label": "My PRs",
      "endpoint": "/search/issues?q=is:open+is:pr+author:@me&per_page=30",
      "widgets": [
        {
          "id": "my_prs",
          "type": "list",
          "title": "Open pull requests",
          "tint": "Green",
          "glyph": "none",
          "endpoint": "/search/issues?q=is:open+is:pr+author:@me&per_page=30",
          "itemsPath": "items",
          "titlePath": "title",
          "subtitlePath": "",
          "badgePath": "",
          "metaPath": "updated_at",
          "detail": {
            "bodyPath": "body",
            "urlPath": "html_url",
            "fields": [
              {
                "label": "Author",
                "path": "user.login"
              },
              {
                "label": "Branch",
                "path": "head.ref"
              },
              {
                "label": "Into",
                "path": "base.ref"
              },
              {
                "label": "Merge status",
                "path": "{{mergeable_state|map:dirty=Has conflicts;clean=Ready to merge;blocked=Waiting for reviews or checks;unstable=Checks failing;behind=Behind its base branch;unknown=Checking;draft=Draft}}"
              },
              {
                "label": "Changed files",
                "path": "changed_files"
              },
              {
                "label": "Updated",
                "path": "updated_at"
              }
            ],
            "endpoint": "{{pull_request.url}}",
            "actions": [
              {
                "id": "comment_pr",
                "title": "Comment",
                "method": "POST",
                "endpoint": "{{comments_url}}",
                "bodyTemplate": "{\"body\":\"{{comment}}\"}",
                "params": [
                  {
                    "key": "comment",
                    "label": "Comment"
                  }
                ],
                "tint": "Blue",
                "glyph": "quote"
              },
              {
                "id": "merge_pr",
                "title": "Merge",
                "method": "PUT",
                "endpoint": "{{pull_request.url}}/merge",
                "tint": "Indigo",
                "glyph": "branch",
                "confirmMessage": "Merge “{{title}}”? If it has conflicts, GitHub will refuse; fix them first or close it."
              },
              {
                "id": "close_pr",
                "title": "Close pull request",
                "method": "PATCH",
                "endpoint": "{{pull_request.url}}",
                "bodyTemplate": "{\"state\":\"closed\"}",
                "tint": "Red",
                "glyph": "x",
                "confirmMessage": "Close “{{title}}” without merging? You can reopen it on GitHub."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "reviews",
      "label": "Reviews",
      "endpoint": "/search/issues?q=is:open+is:pr+review-requested:@me&per_page=30",
      "widgets": [
        {
          "id": "reviews",
          "type": "list",
          "title": "Waiting for your review",
          "tint": "Orange",
          "glyph": "none",
          "endpoint": "/search/issues?q=is:open+is:pr+review-requested:@me&per_page=30",
          "itemsPath": "items",
          "titlePath": "title",
          "subtitlePath": "user.login",
          "badgePath": "",
          "metaPath": "updated_at",
          "detail": {
            "bodyPath": "body",
            "urlPath": "html_url",
            "fields": [
              {
                "label": "Author",
                "path": "user.login"
              },
              {
                "label": "Branch",
                "path": "head.ref"
              },
              {
                "label": "Into",
                "path": "base.ref"
              },
              {
                "label": "Merge status",
                "path": "{{mergeable_state|map:dirty=Has conflicts;clean=Ready to merge;blocked=Waiting for reviews or checks;unstable=Checks failing;behind=Behind its base branch;unknown=Checking;draft=Draft}}"
              },
              {
                "label": "Changed files",
                "path": "changed_files"
              },
              {
                "label": "Updated",
                "path": "updated_at"
              }
            ],
            "endpoint": "{{pull_request.url}}",
            "actions": [
              {
                "id": "approve_pr",
                "title": "Approve",
                "method": "POST",
                "endpoint": "{{pull_request.url}}/reviews",
                "bodyTemplate": "{\"event\":\"APPROVE\"}",
                "tint": "Green",
                "glyph": "check"
              },
              {
                "id": "request_changes",
                "title": "Request changes",
                "method": "POST",
                "endpoint": "{{pull_request.url}}/reviews",
                "bodyTemplate": "{\"event\":\"REQUEST_CHANGES\",\"body\":\"{{comment}}\"}",
                "params": [
                  {
                    "key": "comment",
                    "label": "What needs to change?"
                  }
                ],
                "tint": "Orange",
                "glyph": "undo"
              },
              {
                "id": "comment_pr",
                "title": "Comment",
                "method": "POST",
                "endpoint": "{{comments_url}}",
                "bodyTemplate": "{\"body\":\"{{comment}}\"}",
                "params": [
                  {
                    "key": "comment",
                    "label": "Comment"
                  }
                ],
                "tint": "Blue",
                "glyph": "quote"
              },
              {
                "id": "merge_pr",
                "title": "Merge",
                "method": "PUT",
                "endpoint": "{{pull_request.url}}/merge",
                "tint": "Indigo",
                "glyph": "branch",
                "confirmMessage": "Merge “{{title}}”? If it has conflicts, GitHub will refuse; fix them first or close it."
              },
              {
                "id": "close_pr",
                "title": "Close pull request",
                "method": "PATCH",
                "endpoint": "{{pull_request.url}}",
                "bodyTemplate": "{\"state\":\"closed\"}",
                "tint": "Red",
                "glyph": "x",
                "confirmMessage": "Close “{{title}}” without merging? You can reopen it on GitHub."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "issues",
      "label": "Issues",
      "endpoint": "/issues?filter=assigned&state=open&per_page=30",
      "widgets": [
        {
          "id": "issues",
          "type": "list",
          "title": "Assigned to you",
          "tint": "Red",
          "glyph": "none",
          "endpoint": "/issues?filter=assigned&state=open&per_page=30",
          "itemsPath": "",
          "titlePath": "title",
          "subtitlePath": "repository.full_name",
          "badgePath": "",
          "metaPath": "updated_at",
          "detail": {
            "bodyPath": "body",
            "urlPath": "html_url",
            "fields": [
              {
                "label": "Repository",
                "path": "repository.full_name"
              },
              {
                "label": "Updated",
                "path": "updated_at"
              }
            ]
          }
        }
      ]
    }
  ],
  "globalActions": []
}
