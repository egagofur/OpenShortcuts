{
  "format": "openshortcuts-adapter",
  "version": 2,
  "id": "stracode",
  "name": "Stracode",
  "subtitle": "Your commits as a card to share, like a run",
  "glyph": "laptopRun",
  "tint": "Green",
  "baseUrl": "https://api.github.com",
  "allowedDomains": [],
  "authKind": "bearer",
  "authHeader": "Authorization",
  "authPrefix": "Bearer ",
  "tokenHint": "Optional: a token adds your private repos",
  "tokenOptional": true,
  "inputs": [
    {
      "key": "username",
      "label": "GitHub username",
      "hint": "e.g. octocat"
    }
  ],
  "tabs": [
    {
      "id": "ship",
      "label": "Stracode",
      "endpoint": "/users/{{input.username}}",
      "widgets": [
        {
          "id": "ship",
          "type": "share_card",
          "title": "Make a Stracode card",
          "tint": "Green",
          "glyph": "laptopRun",
          "endpoint": "/users/{{input.username}}",
          "titlePath": "login",
          "itemsEndpoint": "/search/commits?q=author:{{login}}+author-date:%3E%3D{{since_120d}}&sort=author-date&order=desc&per_page=100",
          "itemsPath": "items",
          "metaPath": "commit.author.date",
          "messagePath": "commit.message",
          "groupPath": "repository.full_name"
        },
        {
          "id": "me",
          "type": "profile_card",
          "title": "Profile",
          "tint": "Gray",
          "endpoint": "/users/{{input.username}}",
          "titlePath": "name",
          "subtitlePath": "login",
          "metaPath": "html_url",
          "badgePath": "type"
        },
        {
          "id": "stats",
          "type": "stat_grid",
          "title": "Account",
          "endpoint": "/users/{{input.username}}",
          "metrics": [
            {
              "label": "Public repos",
              "valuePath": "public_repos",
              "tint": "Blue"
            },
            {
              "label": "Followers",
              "valuePath": "followers",
              "tint": "Indigo"
            }
          ]
        }
      ]
    }
  ],
  "globalActions": []
}
