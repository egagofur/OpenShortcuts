{
  "format": "openshortcuts-adapter",
  "version": 2,
  "id": "stracode",
  "name": "Stracode",
  "subtitle": "Your GitHub, at a glance, and a card to share",
  "glyph": "laptopRun",
  "tint": "Green",
  "baseUrl": "https://api.github.com",
  "allowedDomains": [],
  "authKind": "bearer",
  "authHeader": "Authorization",
  "authPrefix": "Bearer ",
  "tokenHint": "Optional: a token adds your private repos",
  "tokenOptional": true,
  "inputs": [
    {
      "key": "username",
      "label": "GitHub username",
      "hint": "e.g. octocat"
    }
  ],
  "tabs": [
    {
      "id": "ship",
      "label": "Overview",
      "endpoint": "/users/{{input.username}}",
      "widgets": [
        {
          "id": "ship",
          "type": "share_card",
          "title": "Make a Stracode card",
          "tint": "Green",
          "glyph": "laptopRun",
          "endpoint": "/users/{{input.username}}",
          "titlePath": "login",
          "itemsEndpoint": "/search/commits?q=author:{{login}}+author-date:%3E%3D{{since_120d}}&sort=author-date&order=desc&per_page=100",
          "itemsPath": "items",
          "metaPath": "commit.author.date",
          "messagePath": "commit.message",
          "groupPath": "repository.full_name"
        },
        {
          "id": "me",
          "type": "profile_card",
          "title": "Profile",
          "tint": "Gray",
          "endpoint": "/users/{{input.username}}",
          "titlePath": "name",
          "subtitlePath": "login",
          "metaPath": "bio",
          "badgePath": "location"
        },
        {
          "id": "stats",
          "type": "stat_grid",
          "title": "Account",
          "endpoint": "/users/{{input.username}}",
          "metrics": [
            {
              "label": "Public repos",
              "valuePath": "public_repos",
              "tint": "Blue"
            },
            {
              "label": "Followers",
              "valuePath": "followers",
              "tint": "Indigo"
            },
            {
              "label": "Following",
              "valuePath": "following",
              "tint": "Purple"
            },
            {
              "label": "Gists",
              "valuePath": "public_gists",
              "tint": "Teal"
            }
          ]
        },
        {
          "id": "heat",
          "type": "heatmap_chart",
          "title": "Public activity",
          "tint": "Green",
          "endpoint": "/users/{{input.username}}/events/public?per_page=100",
          "pages": 3,
          "itemsPath": "",
          "metaPath": "created_at",
          "unit": "Pushes, PRs, reviews & stars"
        },
        {
          "id": "week",
          "type": "bar_chart",
          "title": "This week",
          "tint": "Green",
          "endpoint": "/users/{{input.username}}/events/public?per_page=100",
          "pages": 3,
          "itemsPath": "",
          "metaPath": "created_at",
          "range": "thisWeek"
        }
      ]
    },
    {
      "id": "repos",
      "label": "Repos",
      "endpoint": "/users/{{input.username}}/repos?sort=pushed&per_page=100",
      "widgets": [
        {
          "id": "langs",
          "type": "breakdown",
          "title": "Languages",
          "tint": "Blue",
          "endpoint": "/users/{{input.username}}/repos?sort=pushed&per_page=100",
          "itemsPath": "",
          "groupPath": "language",
          "count": 5
        },
        {
          "id": "stars",
          "type": "breakdown",
          "title": "Most starred",
          "tint": "Orange",
          "endpoint": "/users/{{input.username}}/repos?sort=pushed&per_page=100",
          "itemsPath": "",
          "groupPath": "name",
          "valuePath": "stargazers_count",
          "unit": "★",
          "count": 5
        },
        {
          "id": "recent",
          "type": "list",
          "title": "Recently pushed",
          "tint": "Green",
          "glyph": "none",
          "endpoint": "/users/{{input.username}}/repos?sort=pushed&per_page=100",
          "itemsPath": "",
          "titlePath": "name",
          "subtitlePath": "description",
          "badgePath": "language",
          "metaPath": "pushed_at",
          "detail": {
            "bodyPath": "description",
            "urlPath": "html_url",
            "fields": [
              {
                "label": "Stars",
                "path": "stargazers_count"
              },
              {
                "label": "Forks",
                "path": "forks_count"
              },
              {
                "label": "Language",
                "path": "language"
              },
              {
                "label": "Updated",
                "path": "pushed_at"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "activity",
      "label": "Activity",
      "endpoint": "/users/{{input.username}}/events/public?per_page=100",
      "widgets": [
        {
          "id": "where",
          "type": "breakdown",
          "title": "Where you worked",
          "tint": "Indigo",
          "endpoint": "/users/{{input.username}}/events/public?per_page=100",
          "pages": 3,
          "itemsPath": "",
          "groupPath": "repo.name",
          "count": 5
        },
        {
          "id": "events",
          "type": "list",
          "title": "Latest activity",
          "tint": "Gray",
          "glyph": "none",
          "endpoint": "/users/{{input.username}}/events/public?per_page=100",
          "pages": 3,
          "itemsPath": "",
          "titlePath": "repo.name",
          "subtitlePath": "type",
          "metaPath": "created_at"
        }
      ]
    }
  ],
  "globalActions": []
}
